# Prefix: Prefix
@figures = [\zero \one \two \three \four \five \six \seven \eight \nine];
@figures_lining = [\zero.lining \one.lining \two.lining \three.lining \four.lining \five.lining \six.lining \seven.lining \eight.lining \nine.lining];
@figures_numr = [\zero.num \one.num \two.num \three.num \four.num \five.num \six.num \seven.num \eight.num \nine.num];
@figures_dnom = [\zero.den \one.den \two.den \three.den \four.den \five.den \six.den \seven.den \eight.den \nine.den];

feature frac {
    @slash = [\slash \fraction \fraction.frac];

    sub @figures by @figures_numr;
    sub [@slash @figures_dnom] @figures_numr' by @figures_dnom;
    sub slash by fraction.frac;
    sub fraction by fraction.frac;
} frac;

include(../../features/ligatures.fea);
include(../../features/figure_casing.fea);
include(../../features/figure_spacing.fea);

feature numr {
    sub @figures by @figures_numr;
    sub @figures_lining by @figures_numr;
} numr;

feature dnom {
    sub @figures by @figures_dnom;
    sub @figures_lining by @figures_dnom;
} dnom;

feature kern {
# The kerning for the Roman font is based on the original ET Book
# metrics for the font with lining figures (LF), not the one with
# old-style figures (OSF). The LF file had far more kerning pairs, in
# some cases duplicates of those in the OSF file, but in other cases
# the same pairs were there for what should be identical characters,
# with different values. The differing values are noted in comments
# next to each pair that differs. Pairs with no such comment either
# had an identical value in both versions, or weren't present in the
# OSF version. The exception is i o, which was in the OSF file but not
# the LF one.

    position space A -7;
    position space C -13;
    position space M -7;
    position space N -7;
    position space Q -10;
    position space S -7;
    position space T -33;
    position space U -13;
    position space V -40;
    position space W -23;
    position space X -20;
    position space Y -53;
    position space Z -20;
    position hyphen zero.lining 19;
    position hyphen one.lining -81;
    position hyphen two.lining -43;
    position hyphen three.lining -46;
    position hyphen five.lining -31;
    position hyphen seven.lining -23;
    position hyphen nine.lining -20;
    position seven four -38;
    position one.lining hyphen -46;
    position four.lining hyphen 27;
    position seven.lining hyphen -54;
    position A d -20;
    position A v -72;
    position A w -68;
    position R o -23;
    position R u -17;
    position T a -57; # OSF: -60
    position T c -47;
    position T d -60; # OSF: -47 (!)
    position T e -57;
    position T g -37;
    position T m -50; # OSF: -63
    position T n -27; # OSF: -53
    position T o -70;
    position T p -37;
    position T q -57;
    position T r -30;
    position T s -33; # OSF: -20
    position T u -80; # OSF: -60
    position T v -66;
    position T w -83;
    position T x -47;
    position T y -60;
    position T z -27;
    position U a -36;
    position U e -32;
    position U n -24;
    position U t -16;
    position V comma -90;
    position V a -113;
    position V c -110;
    position V d -113;
    position V e -96;
    position V f -27;
    position V g -96;
    position V i -13;
    position V m -106;
    position V n -90;
    position V o -96;
    position V p -90;
    position V q -93;
    position V r -66;
    position V s -53;
    position V t -47;
    position V u -80;
    position V v -76;
    position V w -66;
    position V x -83;
    position V y -60;
    position V z -73;
    position W comma -68;
    position W period -72;
    position W a -92;
    position W c -84;
    position W d -96;
    position W e -120;
    position W g -116;
    position W i -10;
    position W m -52;
    position W n -52;
    position W o -83;
    position W p -83;
    position W q -76;
    position W r -43;
    position W t -40;
    position W u -86;
    position W v -88;
    position W w -80;
    position W x -56;
    position W y -80;
    position W z -56;
    position Y a -93; # OSF: -79
    position Y c -83;
    position Y d -86;
    position Y e -76; # OSF: -89
    position Y g -83;
    position Y m -60;
    position Y n -53;
    position Y o -86; # OSF: -109
    position Y p -70;
    position Y q -66;
    position Y r -27;
    position Y s -50;
    position Y t -20; # OSF: -47
    position Y u -76; # OSF: -66
    position Y v -76; # OSF: -53
    position Y w -53; # OSF: -50
    position Y x -57;
    position Y y -50; # OSF: -63
    position i o -20; # from OSF, not in LF
    position z f 20;

    position a.sc j.sc -27;
    position a.sc n.sc -6;
    position a.sc o.sc -12;
    position a.sc r.sc -13;
    position a.sc s.sc -27;
    position a.sc t.sc -33;
    position a.sc u.sc -50;
    position b.sc a.sc -18;
    position b.sc j.sc -20;
    position b.sc n.sc -20;
    position b.sc y.sc -24;
    position c.sc v.sc -7;
    position d.sc a.sc -24;
    position d.sc f.sc -20;
    position d.sc i.sc -18;
    position d.sc m.sc -31;
    position d.sc w.sc -68;
    position e.sc a.sc -3;
    position e.sc r.sc 3;
    position f.sc a.sc -24;
    position f.sc g.sc -13;
    position i.sc e.sc 13;
    position i.sc o.sc -13;
    position l.sc a.sc -33;
    position l.sc y.sc -53;
    position o.sc a.sc -30;
    position o.sc k.sc -18;
    position o.sc n.sc -20;
    position o.sc p.sc -30;
    position o.sc r.sc -13;
    position o.sc v.sc -47;
    position p.sc a.sc -60;
    position p.sc ae.sc -20;
    position q.sc a.sc -24;
    position q.sc w.sc -73;
    position r.sc a.sc -39;
    position r.sc d.sc -18;
    position r.sc e.sc -18;
    position r.sc f.sc -13;
    position r.sc j.sc -20;
    position r.sc o.sc -42;
    position r.sc s.sc -32;
    position r.sc t.sc -93;
    position r.sc u.sc -18;
    position r.sc y.sc -73;
    position s.sc a.sc -6;
    position t.sc a.sc -48;
    position t.sc y.sc -7;
    position u.sc a.sc -58;
    position u.sc h.sc -18;
    position v.sc a.sc -42;
    position v.sc ae.sc -27;
    position w.sc a.sc -110;
    position w.sc c.sc -42;
    position w.sc e.sc -13;
    position w.sc o.sc -27;
    position w.sc s.sc -38;
    position w.sc ae.sc -30;
    position x.sc c.sc -47;
    position x.sc y.sc -6;
    position y.sc a.sc -70;
    position y.sc o.sc -40;
    position y.sc ae.sc -7;
    position z.sc w.sc -33;
} kern;

